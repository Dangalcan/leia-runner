# OWN CONFIGURATION
PORT=5002
REDIS_URL=redis://localhost:6379
DEFAULT_MODEL=openai-responses
RUNNER_KEY=R2D2C3PO

# Image compression settings
AVATAR_KBYTES=4

# Conversation History (Generic)
CONVERSATION_HISTORY_MAX_MESSAGES=60

# Session expiration in Redis
# Seconds a session (and its metadata, history and MultiLEIA runtime) lives
# after its last activity. Default 86400 (24 h). 0 disables expiration.
SESSION_TTL_SECONDS=86400

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EVALUATION_MODEL=gemma3:4b
OLLAMA_HISTORY_MAX_MESSAGES=60

# ALMA Configuration
# The API key is not read from here: it comes from the user's LEIA API key
# (provider "alma") stored in leia-auth, like every other provider.
# ALMA_BASE_URL:              OpenAI-compatible base URL of one ALMA model,
#                             https://alma.us.es/api/models/{slug}/v1. The base URL
#                             of the LEIA API key overrides it.
# ALMA_MODEL:                 Model id sent in the request body (the Hugging Face
#                             repo id the model is served as, not the URL slug).
# ALMA_MAX_TOKENS:            Max tokens per conversation reply.
# ALMA_EVALUATION_MAX_TOKENS: Max tokens per solution evaluation.
ALMA_BASE_URL=https://alma.us.es/api/models/llama-3.1-8b-instruct/v1
ALMA_MODEL=meta-llama/Llama-3.1-8B-Instruct
ALMA_MAX_TOKENS=1024
ALMA_EVALUATION_MAX_TOKENS=2048
ALMA_TEMPERATURE=0.7
ALMA_HISTORY_MAX_MESSAGES=60

# AUTH SERVICE CONFIGURATION
VITE_AUTH_SERVICE_BACKEND=http://localhost:3005

# Intern Token
INTERN_TOKEN=secret_intern_token
